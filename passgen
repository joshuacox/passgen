  for fn in "${funcs[@]}"; do
    echo "=== $fn ==="
    "$fn" "$PASS_LENGTH"
    horizontal_rule
  done
  echo "=== gen_passphrase (4 words) ==="
  gen_passphrase 4
  horizontal_rule
}

usage() {
  cat <<'EOF'
Passgen - The CLI Password Generator

Usage:
  passgen [OPTIONS] [LENGTH]

Options:
  -l, --length <N>     Set password length (default: 16)
  -c, --count <N>      Generate N passwords (default: 1)
  -w, --words <N>      Generate a multi-word passphrase with N words (default: 4)
  -p, --pin <N>        Generate numeric PIN of length N
  -o, --obedient       Generate obedient passwords matching exact length
  -u, --unsafe         Generate password using unfiltered graph characters
  -a, --all, -v        Generate comprehensive suite of random passwords
  -l, --long           Generate long hash passwords
  -n, --no-clip        Do not copy to clipboard (print to stdout only)
  -e, --analyze        Calculate entropy of the generated password (requires ent)
  --osc52              Emit OSC 52 terminal clipboard sequence (works over SSH)
  --clear <SEC>        Auto-clear clipboard after SEC seconds
  -t, --test           Run generator test suite
  -h, --help           Show this help message

Examples:
  passgen              Generate 16-char secure password and copy to clipboard
  passgen 24           Generate 24-char secure password
  passgen -w 5         Generate 5-word Diceware passphrase
  passgen -c 5 -n      Generate 5 passwords without copying
  passgen -o 20        Generate 20 length-obedient passwords
EOF
}

main() {
  detect_clipboard

  local WORD_COUNT=4
  local re='^[0-9]+$'

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      -n|--no-clip)
        NO_CLIP=1
        shift
        ;;
      -e|--analyze)
        ANALYZE=1
        shift
        ;;
      --osc52)
        USE_OSC52=1
        shift
        ;;
      --clear)
        CLEAR_SECONDS="$2"
        shift 2
        ;;
      -c|--count)
        COUNT="$2"
        shift 2
        ;;
      -l|--length)
        PASS_LENGTH="$2"
        shift 2
        ;;
      -w|--words)
        MODE="passphrase"
        if [[ -n "$2" && "$2" =~ $re ]]; then
          WORD_COUNT="$2"
          shift 2
        else
          shift
        fi
        ;;
      -p|--pin)
        MODE="pin"
        if [[ -n "$2" && "$2" =~ $re ]]; then
          PASS_LENGTH="$2"
          shift 2
        else
          shift
        fi
        ;;
      -o|--obedient)
        MODE="obedient"
        shift
        ;;
      -u|--unsafe)
        MODE="unsafe"
        shift
        ;;
      -a|--all|-v)
        MODE="all"
        shift
        ;;
      --long)
        MODE="long"
        shift
        ;;
      -t|--test)
        MODE="test"
        shift
        ;;
      *)
        if [[ "$1" =~ $re ]]; then
          PASS_LENGTH="$1"
        else
          echo "Unknown option: $1" >&2
          usage >&2
          exit 1
        fi
        shift
        ;;
    esac
  done

  case "$MODE" in
    all)
      obedient
      disobedient
      longshots
      exit 0
      ;;
    long)
      longshots
      exit 0
      ;;
    obedient)
      obedient
      exit 0
      ;;
    test)
      tests
      exit 0
      ;;
    passphrase)
      local last=""
      for ((i=0; i<COUNT; i++)); do
        last=$(gen_passphrase "$WORD_COUNT")
        echo "$last"
      done
      copy_to_clipboard "$last"
      if [[ "$ANALYZE" -eq 1 ]]; then
        if command -v ent >/dev/null 2>&1; then
          printf "%s" "$last" | ent
        else
          echo "Error: 'ent' command is required for analysis." >&2
        fi
      fi
      ;;
    pin)
      local last=""
      for ((i=0; i<COUNT; i++)); do
        last=$(gen_pin "$PASS_LENGTH")
        echo "$last"
      done
      copy_to_clipboard "$last"
      if [[ "$ANALYZE" -eq 1 ]]; then
        if command -v ent >/dev/null 2>&1; then
          printf "%s" "$last" | ent
        else
          echo "Error: 'ent' command is required for analysis." >&2
        fi
      fi
      ;;
    unsafe)
      local last=""
      for ((i=0; i<COUNT; i++)); do
        last=$(unsafe "$PASS_LENGTH")
        echo "$last"
      done
      copy_to_clipboard "$last"
      if [[ "$ANALYZE" -eq 1 ]]; then
        if command -v ent >/dev/null 2>&1; then
          printf "%s" "$last" | ent
        else
          echo "Error: 'ent' command is required for analysis." >&2
        fi
      fi
      ;;
    shuffy)
      local last=""
      for ((i=0; i<COUNT; i++)); do
        shuffy
        echo "$RESULT"
        last="$RESULT"
      done
      copy_to_clipboard "$last"
      if [[ "$ANALYZE" -eq 1 ]]; then
        if command -v ent >/dev/null 2>&1; then
          printf "%s" "$last" | ent
        else
          echo "Error: 'ent' command is required for analysis." >&2
        fi
      fi
      ;;
  esac
}

main "$@"
