#!/usr/bin/env bash
# Generate secure passwords, passphrases, and tokens with flexible clipboard and terminal integration.

set -o pipefail 2>/dev/null || true

# Global configuration defaults
PASS_LENGTH=16
COUNT=1
MODE="shuffy"
NO_CLIP=0
CLEAR_SECONDS=0
USE_OSC52=0
RESULT=""

# Determine clipboard backends
detect_clipboard() {
  CLIP_BACKEND="none"
  if [[ "$XDG_SESSION_TYPE" == "wayland" ]] && command -v wl-copy >/dev/null 2>&1; then
    CLIP_BACKEND="wayland"
  elif [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-copy >/dev/null 2>&1; then
    CLIP_BACKEND="wayland"
  elif [[ -n "$DISPLAY" ]] && command -v xclip >/dev/null 2>&1; then
    CLIP_BACKEND="xclip"
  elif [[ -n "$DISPLAY" ]] && command -v xsel >/dev/null 2>&1; then
    CLIP_BACKEND="xsel"
  elif command -v pbcopy >/dev/null 2>&1; then
    CLIP_BACKEND="pbcopy"
  fi
}

copy_to_clipboard() {
  local text="$1"
  if [[ "$NO_CLIP" -eq 1 ]]; then
    return 0
  fi

  if [[ "$USE_OSC52" -eq 1 ]]; then
    local b64
    b64=$(printf "%s" "$text" | base64 | tr -d '\r\n')
    # OSC 52 sequence to clipboard
    printf "\033]52;c;%s\007" "$b64" > /dev/tty 2>/dev/null || true
  fi

  case "$CLIP_BACKEND" in
    wayland)
      printf "%s" "$text" | wl-copy --primary >/dev/null 2>&1 || true
      printf "%s" "$text" | wl-copy >/dev/null 2>&1 || true
      ;;
    xclip)
      printf "%s" "$text" | xclip -i -selection clipboard >/dev/null 2>&1 || true
      printf "%s" "$text" | xclip -i -selection primary >/dev/null 2>&1 || true
      printf "%s" "$text" | xclip -i -selection secondary >/dev/null 2>&1 || true
      ;;
    xsel)
      printf "%s" "$text" | xsel -b -i >/dev/null 2>&1 || true
      printf "%s" "$text" | xsel -p -i >/dev/null 2>&1 || true
      ;;
    pbcopy)
      printf "%s" "$text" | pbcopy >/dev/null 2>&1 || true
      ;;
    none)
      # In headless or environments without tools, do nothing silently
      ;;
  esac

  if [[ "$CLEAR_SECONDS" -gt 0 && "$CLIP_BACKEND" != "none" ]]; then
    schedule_clipboard_clear "$CLEAR_SECONDS"
  fi
}

schedule_clipboard_clear() {
  local delay="$1"
  (
    sleep "$delay"
    case "$CLIP_BACKEND" in
      wayland)
        wl-copy --clear >/dev/null 2>&1 || wl-copy "" >/dev/null 2>&1
        ;;
      xclip)
        printf "" | xclip -i -selection clipboard >/dev/null 2>&1 || true
        printf "" | xclip -i -selection primary >/dev/null 2>&1 || true
        ;;
      xsel)
        xsel -c -b >/dev/null 2>&1 || true
        ;;
      pbcopy)
        printf "" | pbcopy >/dev/null 2>&1 || true
        ;;
    esac
  ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

horizontal_rule() {
  local cols="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
  printf '%*s\n' "$cols" '' | tr ' ' "-"
}

# --- Password & Token Generators ---

gen_urandom_alnum() {
  local len="${1:-$PASS_LENGTH}"
  LC_ALL=C tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c "$len"
  echo
}

gen_urandom_all_printable() {
  local len="${1:-$PASS_LENGTH}"
  LC_ALL=C tr -dc 'A-Za-z0-9!@#$%^&*()_+-=[]{}|;:,.<>?' < /dev/urandom | head -c "$len"
  echo
}

gen_urandom_safe_symbols() {
  local len="${1:-$PASS_LENGTH}"
  LC_ALL=C tr -dc 'a-zA-Z0-9!@#$%*+=-_' < /dev/urandom | head -c "$len"
  echo
}

gen_openssl_base64() {
  local len="${1:-$PASS_LENGTH}"
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 "$(( len * 2 ))" 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c "$len"
    echo
  else
    gen_urandom_alnum "$len"
  fi
}

gen_openssl_hex() {
  local len="${1:-$PASS_LENGTH}"
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$(( (len + 1) / 2 ))" 2>/dev/null | head -c "$len"
    echo
  else
    LC_ALL=C tr -dc '0-9a-f' < /dev/urandom | head -c "$len"
    echo
  fi
}

gen_gpg_rand() {
  local len="${1:-$PASS_LENGTH}"
  if command -v gpg >/dev/null 2>&1; then
    gpg --gen-random 1 "$(( len * 4 + 64 ))" 2>/dev/null | base64 | tr -dc 'a-zA-Z0-9_.-' | head -c "$len"
    echo
  else
    gen_urandom_safe_symbols "$len"
  fi
}

gen_pwgen_secure() {
  local len="${1:-$PASS_LENGTH}"
  if command -v pwgen >/dev/null 2>&1; then
    pwgen --secure "$len" 1
  else
    gen_urandom_all_printable "$len"
  fi
}

gen_pwgen_symbols() {
  local len="${1:-$PASS_LENGTH}"
  if command -v pwgen >/dev/null 2>&1; then
    pwgen --secure --symbols "$len" 1
  else
    gen_urandom_safe_symbols "$len"
  fi
}

gen_pwgen_no_vowels() {
  local len="${1:-$PASS_LENGTH}"
  if command -v pwgen >/dev/null 2>&1; then
    pwgen --secure --no-vowels "$len" 1
  else
    LC_ALL=C tr -dc 'bcdfghjklmnpqrstvwxyzBCDFGHJKLMNPQRSTVWXYZ0-9' < /dev/urandom | head -c "$len"
    echo
  fi
}

gen_apg_pronounced() {
  local len="${1:-$PASS_LENGTH}"
  if command -v apg >/dev/null 2>&1; then
    apg -a 0 -n1 -m "$len" -x "$len" 2>/dev/null || gen_urandom_alnum "$len"
  else
    gen_urandom_alnum "$len"
  fi
}

gen_apg_random() {
  local len="${1:-$PASS_LENGTH}"
  if command -v apg >/dev/null 2>&1; then
    apg -a 1 -n1 -m "$len" -x "$len" 2>/dev/null || gen_urandom_all_printable "$len"
  else
    gen_urandom_all_printable "$len"
  fi
}

gen_pin() {
  local len="${1:-$PASS_LENGTH}"
  LC_ALL=C tr -dc '0-9' < /dev/urandom | head -c "$len"
  echo
}

gen_passphrase() {
  local word_count="${1:-4}"
  local wordlist=()
  if [[ -f "/usr/share/dict/words" ]]; then
    # Filter 4 to 8 char common alphabetic words
    mapfile -t wordlist < <(grep -E '^[a-z]{4,8}$' /usr/share/dict/words 2>/dev/null | shuf -n "$word_count" 2>/dev/null)
  fi

  if [[ ${#wordlist[@]} -lt "$word_count" ]]; then
    local fallback_words=(
      "apple" "banana" "orange" "river" "mountain" "cloud" "forest" "silver"
      "golden" "ember" "falcon" "winter" "summer" "castle" "shield" "dragon"
      "harbor" "whisper" "timber" "shadow" "beacon" "zenith" "vortex" "planet"
      "galaxy" "canyon" "desert" "valley" "meadow" "island" "pebble" "stream"
      "anchor" "bridge" "compass" "feather" "hammer" "lantern" "mirror" "sailor"
    )
    wordlist=()
    local total=${#fallback_words[@]}
    for (( i=0; i<word_count; i++ )); do
      local idx=$(( RANDOM % total ))
      wordlist+=( "${fallback_words[$idx]}" )
    done
  fi

  local joined
  printf -v joined "%s-" "${wordlist[@]}"
  echo "${joined%-}"
}

# Unsafe: unconstrained binary-to-graph character stream
unsafe() {
  local len="${1:-$PASS_LENGTH}"
  LC_ALL=C tr -dc '[:graph:]' < /dev/urandom | head -c "$len"
  echo
}

obedient() {
  if command -v apg >/dev/null 2>&1; then
    apg -a 1 -n20 -m "$PASS_LENGTH" -x "$PASS_LENGTH"
  else
    for ((i=0; i<20; i++)); do
      gen_urandom_all_printable "$PASS_LENGTH"
    done
  fi
}

disobedient() {
  if command -v apg >/dev/null 2>&1; then
    apg -a 0 -n20
  else
    for ((i=0; i<20; i++)); do
      gen_urandom_alnum 12
    done
  fi
}

longshots() {
  local cols="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
  local m_cols=$(( cols < 250 ? cols : 249 ))
  if command -v apg >/dev/null 2>&1; then
    apg -a 1 -n20 -m "$m_cols" -x "$m_cols"
    apg -n10 -x 50
    apg -n10 -l -x 10
    apg -n10 -y -x 25
    apg -n10 -t -x 25
  else
    for ((i=0; i<20; i++)); do
      gen_urandom_all_printable "$m_cols"
    done
  fi
}

# shuffy pool selector
shuffy() {
  local choice
  choice=$(( RANDOM % 10 + 1 ))
  case "$choice" in
    1) RESULT=$(gen_urandom_alnum "$PASS_LENGTH") ;;
    2) RESULT=$(gen_urandom_all_printable "$PASS_LENGTH") ;;
    3) RESULT=$(gen_urandom_safe_symbols "$PASS_LENGTH") ;;
    4) RESULT=$(gen_openssl_base64 "$PASS_LENGTH") ;;
    5) RESULT=$(gen_openssl_hex "$PASS_LENGTH") ;;
    6) RESULT=$(gen_gpg_rand "$PASS_LENGTH") ;;
    7) RESULT=$(gen_pwgen_secure "$PASS_LENGTH") ;;
    8) RESULT=$(gen_pwgen_symbols "$PASS_LENGTH") ;;
    9) RESULT=$(gen_apg_pronounced "$PASS_LENGTH") ;;
    *) RESULT=$(gen_apg_random "$PASS_LENGTH") ;;
  esac
}

# Self tests
tests() {
  local funcs=(
    gen_urandom_alnum
    gen_urandom_all_printable
    gen_urandom_safe_symbols
    gen_openssl_base64
    gen_openssl_hex
    gen_gpg_rand
    gen_pwgen_secure
    gen_pwgen_symbols
    gen_pwgen_no_vowels
    gen_apg_pronounced
    gen_apg_random
    gen_pin
    unsafe
  )
  for fn in "${funcs[@]}"; do
    echo "=== $fn ==="
    "$fn" "$PASS_LENGTH"
    horizontal_rule
  done
  echo "=== gen_passphrase (4 words) ==="
  gen_passphrase 4
  horizontal_rule
}

usage() {
  cat <<'EOF'
Passgen - The CLI Password Generator

Usage:
  passgen [OPTIONS] [LENGTH]

Options:
  -l, --length <N>     Set password length (default: 16)
  -c, --count <N>      Generate N passwords (default: 1)
  -w, --words <N>      Generate a multi-word passphrase with N words (default: 4)
  -p, --pin <N>        Generate numeric PIN of length N
  -o, --obedient       Generate obedient passwords matching exact length
  -u, --unsafe         Generate password using unfiltered graph characters
  -a, --all, -v        Generate comprehensive suite of random passwords
  -l, --long           Generate long hash passwords
  -n, --no-clip        Do not copy to clipboard (print to stdout only)
  --osc52              Emit OSC 52 terminal clipboard sequence (works over SSH)
  --clear <SEC>        Auto-clear clipboard after SEC seconds
  -t, --test           Run generator test suite
  -h, --help           Show this help message

Examples:
  passgen              Generate 16-char secure password and copy to clipboard
  passgen 24           Generate 24-char secure password
  passgen -w 5         Generate 5-word Diceware passphrase
  passgen -c 5 -n      Generate 5 passwords without copying
  passgen -o 20        Generate 20 length-obedient passwords
EOF
}

main() {
  detect_clipboard

  local WORD_COUNT=4
  local re='^[0-9]+$'

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      -n|--no-clip)
        NO_CLIP=1
        shift
        ;;
      --osc52)
        USE_OSC52=1
        shift
        ;;
      --clear)
        CLEAR_SECONDS="$2"
        shift 2
        ;;
      -c|--count)
        COUNT="$2"
        shift 2
        ;;
      -l|--length)
        PASS_LENGTH="$2"
        shift 2
        ;;
      -w|--words)
        MODE="passphrase"
        if [[ -n "$2" && "$2" =~ $re ]]; then
          WORD_COUNT="$2"
          shift 2
        else
          shift
        fi
        ;;
      -p|--pin)
        MODE="pin"
        if [[ -n "$2" && "$2" =~ $re ]]; then
          PASS_LENGTH="$2"
          shift 2
        else
          shift
        fi
        ;;
      -o|--obedient)
        MODE="obedient"
        shift
        ;;
      -u|--unsafe)
        MODE="unsafe"
        shift
        ;;
      -a|--all|-v)
        MODE="all"
        shift
        ;;
      --long)
        MODE="long"
        shift
        ;;
      -t|--test)
        MODE="test"
        shift
        ;;
      *)
        if [[ "$1" =~ $re ]]; then
          PASS_LENGTH="$1"
        else
          echo "Unknown option: $1" >&2
          usage >&2
          exit 1
        fi
        shift
        ;;
    esac
  done

  case "$MODE" in
    all)
      obedient
      disobedient
      longshots
      exit 0
      ;;
    long)
      longshots
      exit 0
      ;;
    obedient)
      obedient
      exit 0
      ;;
    test)
      tests
      exit 0
      ;;
    passphrase)
      local last=""
      for ((i=0; i<COUNT; i++)); do
        last=$(gen_passphrase "$WORD_COUNT")
        echo "$last"
      done
      copy_to_clipboard "$last"
      ;;
    pin)
      local last=""
      for ((i=0; i<COUNT; i++)); do
        last=$(gen_pin "$PASS_LENGTH")
        echo "$last"
      done
      copy_to_clipboard "$last"
      ;;
    unsafe)
      local last=""
      for ((i=0; i<COUNT; i++)); do
        last=$(unsafe "$PASS_LENGTH")
        echo "$last"
      done
      copy_to_clipboard "$last"
      ;;
    shuffy)
      local last=""
      for ((i=0; i<COUNT; i++)); do
        shuffy
        echo "$RESULT"
        last="$RESULT"
      done
      copy_to_clipboard "$last"
      ;;
  esac
}

main "$@"
